# MongoDB connection string
MONGODB_URL=mongodb://localhost:27017/ChatAppDB

# Port the server listens on
PORT=3000

# Node environment (set to "production" to enable secure cookies)
NODE_ENV=development

# Secret used to sign JWT auth tokens
JWT_SECRET=change-me

# Secret used to sign session cookies (OAuth handshake)
SESSION_SECRET=change-me

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Origin of the frontend client (used for OAuth redirects)
CLIENT_URL=http://localhost:5173
